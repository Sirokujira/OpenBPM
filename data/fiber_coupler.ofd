# OpenBPM sample : dual-core fiber directional coupler (方向性結合器)
#
# 近接 2 コア間の光結合シミュレーション (BPM)
#   - コア 1 : 中心 x = -4um, 半径 3.0um, n = 1.4504
#   - コア 2 : 中心 x = +4um, 半径 3.0um (コア間エッジギャップ 2um)
#   - クラッド: n = 1.4440, 波長 1.55um
#
# コア 1 のみを励振すると、エバネッセント結合により電力が
# コア 2 へ周期的に移行する (結合長 Lc で全移行、2*Lc で戻る)。
# ファイバカプラ / 溶融延伸カプラの動作原理。
#
# 期待される動作 (BPM のロジック確認ポイント, z = 500um 実測):
#   1. 伝搬とともにコア 2 側 (x > 0) の電力割合が増加する
#      (実測 : コア 2 側電力割合 0.62 @ z=500um)
#   2. 全電力 (コア 1 + コア 2) はほぼ保存される (実測 0.99)
#   3. /field/Efinal で両コアに電力が分配された分布が確認できる
#      (伝搬距離 z を変えると分配比が周期的に変わる)
#   4. modes = 2 で偶 / 奇の超モードが求まる (neff = 1.446308 / 1.445377)。
#      結合長 Lc = lambda / (2 (n_even - n_odd)) = 832.4 um で、
#        - 伝搬 (z = 6mm) のコア 2 電力割合をフィットした Lc = 833.0 um と 0.07% で一致
#        - 結合モード理論 (Snyder & Love, 弱結合近似) の Lc = 860.4 um と 3.2% で一致
#        - z = 500um でのコア 2 割合の予言 sin^2(pi/2 * 500/832.4) = 0.65 (上記 1. と整合)
#      超モードの平均 1.445843 は孤立コア LP01 の厳密解 1.445872 と 3e-5 で一致する。
#      奇超モードは弱く導波する (クラッドとの差が小さい) ため、虚軸伝搬の選択段階が
#      Cayley 写像だとスプリアス格子モードに負けて見つからなかった (後退オイラーで解消)
OpenBPM 2 2
title = dual-core directional coupler (BPM sample)

xmesh = -20e-6 120 20e-6
ymesh = -20e-6 120 20e-6
zmesh = 0 500 500e-6

# material = <type> <epsr> <esgm> <amur> <msgm>
# クラッド (n = 1.4440)
material = 1 2.085136 0 1 0
# コア (n = 1.4504)
material = 1 2.103660 0 1 0

# geometry = <material id> <shape> <x1> <x2> <y1> <y2> <z1> <z2>
geometry = 2 1 -20e-6 20e-6 -20e-6 20e-6 0 500e-6
# コア 1 (x = -4um)
geometry = 3 13 -7e-6 -1e-6 -3e-6 3e-6 0 500e-6
# コア 2 (x = +4um)
geometry = 3 13 1e-6 7e-6 -3e-6 3e-6 0 500e-6

# feed = <dir> <x> <y> <z> <volt> <delay> <z0>
feed = Z -4e-6 0 0 1 0 0

# beam = <w0[m]> <x0[m]> <y0[m]> : コア 1 のみを励振
beam = 3.5e-6 -4e-6 0

# refindex = <n0>
refindex = 1.444

# modes = <n> : 入力断面のモード解析 (偶 / 奇の超モード)
modes = 2

frequency2 = 1.93414489e14 1.93414489e14 0

solver = 100 10 1e-3
abc = 0

end
