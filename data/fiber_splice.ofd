# OpenBPM sample : fiber splice with core diameter mismatch (融着接続のコア径不整合)
#
# コア径の異なる光ファイバ同士の接続損失シミュレーション (BPM)
#   - ファイバ A (z = 0 - 100um)   : コア半径 4.1um (SMF-28 相当)
#   - ファイバ B (z = 100 - 200um) : コア半径 2.0um (細径ファイバ)
#   - 屈折率 : コア n = 1.4504 / クラッド n = 1.4440, 波長 1.55um
#
# モードフィールド半径 (Marcuse の近似式):
#   ファイバ A : V = 2.26 -> w1 = 4.7um
#   ファイバ B : V = 1.10 -> w2 = 7.3um (弱閉じ込めで MFD はむしろ拡大)
#
# 接続損失の理論値 (ガウシアン近似の重なり積分):
#   T = (2*w1*w2/(w1^2+w2^2))^2 = 0.83  (約 0.8dB)
#
# 期待される動作 (BPM のロジック確認ポイント, z = 400um 実測):
#   1. z = 100um の接続点でモード形状が不連続に変化し、
#      LP01 に再結合しない成分 (~17%) がクラッドへ放射される
#   2. 接続点以降の電界はファイバ B の LP01 (w2 = 7.3um) へ向かって
#      拡大していく (実測 w = 5.1um @ z=400um, 整定途中)
#   3. 放射成分は伝搬とともに広がり端部吸収体で吸収されるため、
#      数 mm スケールの伝搬で総電力が T ~ 0.83 倍へ漸近する
OpenBPM 2 2
title = fiber splice with core mismatch (BPM sample)

xmesh = -15e-6 90 15e-6
ymesh = -15e-6 90 15e-6
zmesh = 0 400 400e-6

# material = <type> <epsr> <esgm> <amur> <msgm>
# クラッド (n = 1.4440)
material = 1 2.085136 0 1 0
# コア (n = 1.4504)
material = 1 2.103660 0 1 0

# geometry = <material id> <shape> <x1> <x2> <y1> <y2> <z1> <z2>
geometry = 2 1 -15e-6 15e-6 -15e-6 15e-6 0 400e-6
# ファイバ A : コア半径 4.1um (z = 0 - 100um)
geometry = 3 13 -4.1e-6 4.1e-6 -4.1e-6 4.1e-6 0 100e-6
# ファイバ B : コア半径 2.0um (z = 100 - 400um)
geometry = 3 13 -2.0e-6 2.0e-6 -2.0e-6 2.0e-6 100e-6 400e-6

# feed = <dir> <x> <y> <z> <volt> <delay> <z0>
feed = Z 0 0 0 1 0 0

# beam = <w0[m]> : ファイバ A の LP01 に整合した励振
beam = 4.7e-6

# refindex = <n0>
refindex = 1.444

frequency2 = 1.93414489e14 1.93414489e14 0

solver = 100 10 1e-3
abc = 0

end
