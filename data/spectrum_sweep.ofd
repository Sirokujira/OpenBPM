# OpenBPM sample : wavelength sweep (spectrum)
#
# 波長掃引 (wlsweep = 1) の実演。frequency2 で指定した全周波数点を順に計算し、
# 各波長の透過率 T を spectrum.csv に出力する。
# ファイバ構成は data/fiber.ofd と同一 (SMF-28 相当, LP01 のみ伝搬)。
#
# frequency2 = 1.873703e14 1.998616e14 4  ->  1.60um .. 1.50um の 5 点
#
# 注意:
#   - /field (Efinal/Ixz/frames) と HDF5 メタデータは **最終波長** の結果
#     (波長ごとの場が必要なら 1 波長ずつ実行する)
#   - CUDA 版 (obpm_cuda) は wlsweep 未対応 (実行時 warning)
#
# 期待される動作:
#   1. spectrum.csv に 5 点の (lambda, frequency, transmission) が出る
#   2. 各点の結果はその波長を単独指定した実行と完全一致する
OpenBPM 2 2
title = wavelength sweep / spectrum (BPM sample)

xmesh = -15e-6 90 15e-6
ymesh = -15e-6 90 15e-6
zmesh = 0 200 200e-6

# material = <type> <epsr> <esgm> <amur> <msgm>  (id starts at 2)
# クラッド (n = 1.4440)
material = 1 2.085136 0 1 0
# コア (n = 1.4504)
material = 1 2.103660 0 1 0

# geometry = <material id> <shape> <x1> <x2> <y1> <y2> <z1> <z2>
# クラッド : 計算領域全体 (shape 1 = 直方体)
geometry = 2 1 -15e-6 15e-6 -15e-6 15e-6 0 200e-6
# コア : Z 軸方向の円柱 (shape 13 = Z cylinder, xy 断面が直径 8.2um の円)
geometry = 3 13 -4.1e-6 4.1e-6 -4.1e-6 4.1e-6 0 200e-6

# feed = <dir> <x> <y> <z> <volt> <delay> <z0>  (ビーム中心・振幅として使用)
feed = Z 0 0 0 1 0 0

# beam = <w0[m]> [<x0[m]> <y0[m]>]
# LP01 モードフィールド半径に整合させたガウシアン励振
beam = 4.7e-6

# refindex = <n0> : BPM 参照屈折率 (クラッド屈折率を指定)
refindex = 1.444

# wlsweep = <0|1> : frequency2 の全点を掃引し spectrum.csv を出力する
wlsweep = 1

# 1.60um .. 1.50um の 5 点
frequency2 = 1.873703e14 1.998616e14 4

solver = 100 10 1e-3
abc = 0

end
