# OpenBPM sample : tapered fiber (テーパファイバ / 断熱モード変換)
#
# コア径が徐々に変化するテーパ部のシミュレーション (BPM)
#   - z = 0 - 100um   : コア半径 4.1um (SMF-28 相当)
#   - z = 100 - 260um : コア半径 4.1 -> 2.0um (5 段の階段近似で縮小)
#   - z = 260 - 500um : コア半径 2.0um
#   - 屈折率 : コア n = 1.4504 / クラッド n = 1.4440, 波長 1.55um
#
# data/fiber_splice.ofd (同じ 4.1 -> 2.0um を急峻に接続, 理論損失 ~17%)
# との対比で、緩やかな遷移 (断熱変換) では放射損失が抑制され、
# モードが LP01 形状を保ったまま細径側の分布 (w2 = 7.3um) へ変換される。
#
# 期待される動作 (BPM のロジック確認ポイント, z = 500um 実測):
#   1. /field/Ixz でテーパ部のモード幅が滑らかに変化する様子が見える
#      (幅 2sigma : 4.5um @z=50um -> 7.0um @z=490um, w2=7.3um へ整定)
#   2. 急峻な接続 (splice) と異なり接続点での放射バーストがなく、
#      電力がほぼ保存される (P/P0 = 0.998, 断熱変換)
#   3. テーパ後の電界は細径ファイバの LP01 へ整定していく
OpenBPM 2 2
title = tapered fiber (BPM sample)

xmesh = -15e-6 90 15e-6
ymesh = -15e-6 90 15e-6
zmesh = 0 500 500e-6

# material = <type> <epsr> <esgm> <amur> <msgm>
# クラッド (n = 1.4440)
material = 1 2.085136 0 1 0
# コア (n = 1.4504)
material = 1 2.103660 0 1 0

# geometry = <material id> <shape> <x1> <x2> <y1> <y2> <z1> <z2>
geometry = 2 1 -15e-6 15e-6 -15e-6 15e-6 0 500e-6
# コア半径 4.1um (z = 0 - 100um)
geometry = 3 13 -4.10e-6 4.10e-6 -4.10e-6 4.10e-6 0 100e-6
# テーパ部 : 5 段の階段近似 (z = 100 - 260um)
geometry = 3 13 -3.68e-6 3.68e-6 -3.68e-6 3.68e-6 100e-6 132e-6
geometry = 3 13 -3.26e-6 3.26e-6 -3.26e-6 3.26e-6 132e-6 164e-6
geometry = 3 13 -2.84e-6 2.84e-6 -2.84e-6 2.84e-6 164e-6 196e-6
geometry = 3 13 -2.42e-6 2.42e-6 -2.42e-6 2.42e-6 196e-6 228e-6
geometry = 3 13 -2.20e-6 2.20e-6 -2.20e-6 2.20e-6 228e-6 260e-6
# コア半径 2.0um (z = 260 - 500um)
geometry = 3 13 -2.00e-6 2.00e-6 -2.00e-6 2.00e-6 260e-6 500e-6

# feed = <dir> <x> <y> <z> <volt> <delay> <z0>
feed = Z 0 0 0 1 0 0

# beam = <w0[m]> : 入力側ファイバの LP01 に整合した励振
beam = 4.7e-6

# refindex = <n0>
refindex = 1.444

frequency2 = 1.93414489e14 1.93414489e14 0

solver = 100 10 1e-3
abc = 0

end
