# OpenBPM sample : single-mode optical fiber (SMF-28 相当)
#
# 光ファイバケーブルの動作シミュレーション (BPM)
#   - コア   : 半径 a = 4.1um (直径 8.2um), n_core = 1.4504 (epsr = 2.103660)
#   - クラッド: n_clad = 1.4440 (epsr = 2.085136)
#   - 波長   : 1.55um (frequency = 1.93414489e14 Hz)
#
# 規格化周波数 V = 2*pi*a*NA/lambda
#   NA = sqrt(n_core^2 - n_clad^2) = 0.1361
#   V  = 2.26 < 2.405 -> シングルモード (LP01 のみ伝搬)
#
# LP01 モードフィールド半径 (Marcuse の近似式)
#   w/a = 0.65 + 1.619/V^1.5 + 2.879/V^6 -> w = 4.7um (MFD = 9.4um)
#
# 期待される動作 (BPM のロジック確認ポイント):
#   1. w0 = 4.7um のガウシアンビームは LP01 モードにほぼ整合しており、
#      200um 伝搬してもコアに閉じ込められたまま形状を維持する
#   2. ガウシアンと厳密な LP01 の差分 (数%) はクラッドへ放射され、
#      端部吸収体で吸収される (出力電力がわずかに減少して一定に漸近)
#   3. /field/n_out_r に円形のコア/クラッド屈折率分布が出力される
OpenBPM 2 2
title = single-mode fiber, LP01 mode launch (BPM sample)

xmesh = -15e-6 90 15e-6
ymesh = -15e-6 90 15e-6
zmesh = 0 200 200e-6

# material = <type> <epsr> <esgm> <amur> <msgm>  (id starts at 2)
# クラッド (n = 1.4440)
material = 1 2.085136 0 1 0
# コア (n = 1.4504)
material = 1 2.103660 0 1 0

# geometry = <material id> <shape> <x1> <x2> <y1> <y2> <z1> <z2>
# クラッド : 計算領域全体 (shape 1 = 直方体)
geometry = 2 1 -15e-6 15e-6 -15e-6 15e-6 0 200e-6
# コア : Z 軸方向の円柱 (shape 13 = Z cylinder, xy 断面が直径 8.2um の円)
geometry = 3 13 -4.1e-6 4.1e-6 -4.1e-6 4.1e-6 0 200e-6

# feed = <dir> <x> <y> <z> <volt> <delay> <z0>  (ビーム中心・振幅として使用)
feed = Z 0 0 0 1 0 0

# beam = <w0[m]> [<x0[m]> <y0[m]>]
# LP01 モードフィールド半径に整合させたガウシアン励振
beam = 4.7e-6

# refindex = <n0> : BPM 参照屈折率 (クラッド屈折率を指定)
refindex = 1.444

frequency2 = 1.93414489e14 1.93414489e14 0

solver = 100 10 1e-3
abc = 0

# launch = gauss | mode [<m>] : 励振方法
# mode 指定時は先頭スライスの屈折率分布から導波モード #m (省略時 0 = LP01) を
# 虚軸伝搬法で求めて励振する。モード励振では伝搬に伴う形状変化 (breathing) が
# 起きず、電力・モード形状が保存される (ガウシアン励振との比較用)
launch = mode 0

end
