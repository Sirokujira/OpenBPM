{
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(make:*)",
      "Bash(bin/obpm:*)",
      "Bash(bin/obpm_post:*)",
      "Bash(bin/obpm_cuda:*)",
      "Bash(./bin/obpm:*)",
      "Bash(./bin/obpm_post:*)",
      "Bash(python3 tests/*)",
      "Bash(python3 tools/*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(h5dump:*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
