{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(make:*)",
      "Bash(ninja:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(./bin/obpm:*)",
      "Bash(./bin/obpm_post:*)",
      "Bash(bin/obpm:*)",
      "Bash(bin/obpm_post:*)",
      "Bash(python3 tools/plot_ixz.py:*)",
      "Bash(sh tools/check_activation.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "includeCoAuthoredBy": true
}
